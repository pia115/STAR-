{
  "name": "vintage-photobooth-server",
  "version": "0.1.0",
  "description": "Backend API for the virtual vintage photobooth (memory gallery storage).",
  "type": "module",
  "main": "src/index.js",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
