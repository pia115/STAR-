# Port the API listens on
PORT=4000

# Where the SQLite database and uploaded images are stored
DATA_DIR=./data

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Maximum upload size for a single photo strip, in megabytes
MAX_UPLOAD_MB=10

# Set to "production" when deployed (makes session cookies HTTPS-only)
NODE_ENV=development

# Set to "true" when running behind a reverse proxy / hosting platform
TRUST_PROXY=false
